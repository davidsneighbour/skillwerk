{
  "name": "@davidsneighbour/patternbook",
  "description": "Reusable AI skills for digital design and presentation: design systems, branding, typography, colour, composition, interface patterns, and accessibility.",
  "version": "2.0.0",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidsneighbour/skillwerk.git",
    "directory": "collections/patternbook"
  },
  "scripts": {
    "release": "release-it --config .release-it.ts --ci",
    "release:dry": "release-it --config .release-it.ts --dry-run --ci",
