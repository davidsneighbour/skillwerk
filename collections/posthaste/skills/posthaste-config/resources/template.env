# Keep the real file mode 600. Global ~/.env loads before project .env.

# --- Mastodon
# MASTODON_ACCESS_TOKEN=your-mastodon-access-token
# Bare host only: no scheme, path, or trailing slash.
# MASTODON_HOST="mas.to"

# --- Bluesky
# PDS/API host, never bsky.app; no scheme, path, or trailing slash.
# BLUESKY_HOST="bsky.social"
# BLUESKY_IDENTIFIER=your-handle.bsky.social
# BLUESKY_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- LinkedIn
# LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

# --- Discord (bot)
# DISCORD_BOT_TOKEN=your-discord-bot-token
# DISCORD_CHANNEL_ID=123456789012345678

# --- Discord (webhook)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXX/XXXXX

# --- Telegram
# TELEGRAM_BOT_TOKEN=123456789:your-bot-token
# TELEGRAM_CHAT_ID=@yourusername
# or numeric id: 987654321

# --- dev.to
# DEVTO_API_KEY=########################
