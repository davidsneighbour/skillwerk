{
  "cSpell.customDictionaries": {
    "workspace-dictionary": {
      "addWords": true,
      "name": "workspace-dictionary",
      "path": "${workspaceFolder}/.vscode/dictionary.txt",
      "scope": "workspace"
    }
  },
  "cSpell.dictionaries": [
    "workspace-dictionary"
  ],
  "cSpell.language": "en-GB",
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#008de1",
    "activityBar.background": "#008de1",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#9f0064",
    "activityBarBadge.foreground": "#e7e7e7",
    "activityBarTop.activeBackground": "#008de1",
    "activityBarTop.background": "#008de1",
    "activityBarTop.foreground": "#e7e7e7",
    "activityBarTop.inactiveForeground": "#e7e7e799",
    "commandCenter.border": "#e7e7e799",
    "commandCenter.foreground": "#e7e7e7",
    "sash.hoverBorder": "#008de1",
    "statusBar.background": "#006dae",
    "statusBar.debuggingBackground": "#006dae",
    "statusBar.debuggingForeground": "#e7e7e7",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#008de1",
    "statusBarItem.remoteBackground": "#ff60c3",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#006dae",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#006dae99",
    "titleBar.inactiveForeground": "#e7e7e799"
  },
  "peacock.color": "#006dae"
}
