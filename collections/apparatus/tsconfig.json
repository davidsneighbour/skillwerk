{
  "extends": "@dnbhq/tsconfig/cli",
  "compilerOptions": {
    "allowJs": true,
    "allowUnreachableCode": true,
    "exactOptionalPropertyTypes": false,
    "lib": ["ES2022", "DOM"],
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["skills/**/*.ts", "scripts/**/*.ts", ".release-it.ts"],
  "exclude": ["node_modules", "dist"]
}
