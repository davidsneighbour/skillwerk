{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fettle skill frontmatter",
  "description": "Validates the parsed YAML frontmatter of a SKILL.md file.",
  "type": "object",
  "required": ["metadata"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {
          "type": "string",
          "description": "The individual skill's Semantic Versioning 2.0.0 version.",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
