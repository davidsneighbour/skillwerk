{
  "version": "0.2",
  "language": "en-GB",
  "files": ["**/*"],
  "ignorePaths": [
    ".git",
    ".migration",
    "dist",
    "node_modules",
    "package-lock.json",
    "scratch",
    "collections/*/.github/assets",
    "PROJECT.md",
    "TODO.md"
  ],
  "patterns": [
    {
      "name": "hashtags",
      "pattern": "/#[\\p{L}\\p{N}_]+/gu"
    },
    {
      "name": "hex-colours",
      "pattern": "/\\b[0-9A-Fa-f]{6}\\b/g"
    }
  ],
  "ignoreRegExpList": ["hashtags", "hex-colours"],
  "dictionaryDefinitions": [
    {
      "name": "workspace-words",
      "path": "./.vscode/dictionary.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["workspace-words"]
}
