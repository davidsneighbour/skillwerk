{
  "name": "skillwerk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "check": "node scripts/check.ts",
    "package": "node scripts/package-collection.ts",
    "lint": "npm run lint:code && npm run lint:markdown && npm run lint:spelling && npm run lint:secrets",
    "lint:code": "biome check .",
    "lint:code:fix": "biome check --write .",
    "lint:markdown": "markdownlint-cli2 --config ./node_modules/@dnbhq/markdownlint-config/.markdownlint-cli2.jsonc \"**/*.{md,mdx}\" \"#scratch/**\" \"#**/CHANGELOG.md\" \"#**/node_modules/**\"",
    "lint:markdown:fix": "markdownlint-cli2 --config ./node_modules/@dnbhq/markdownlint-config/.markdownlint-cli2.jsonc --fix \"**/*.{md,mdx}\" \"#scratch/**\" \"#**/CHANGELOG.md\" \"#**/node_modules/**\"",
    "lint:spelling": "cspell .",
    "lint:secrets": "dnb-secretlint --secretlintignore .secretlintignore \"**/*\"",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "validate": "npm run validate:collections && npm run validate:skills",
    "validate:collections": "node scripts/check-collections.ts",
    "validate:skills": "node scripts/validate-all-skills.ts",
    "test": "node --test \"collections/**/*.test.ts\""
  },
  "workspaces": [
    "collections/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@dnbhq/biome-config": "0.3.1",
    "@dnbhq/markdownlint-config": "0.2.11",
    "@dnbhq/release-config": "1.1.3",
    "@dnbhq/secretlint-config": "0.1.1",
    "@dnbhq/tsconfig": "0.1.6",
    "@release-it/conventional-changelog": "12.0.0",
    "@types/node": "26.4.1",
    "@types/twitter-text": "3.1.10",
    "@types/yargs": "17.0.33",
    "cspell": "10.2.0",
    "playwright": "1.55.1",
    "release-it": "21.0.2",
    "sharp": "0.34.4",
    "smol-toml": "1.8.0",
    "twitter-text": "3.1.0",
    "typescript": "7.0.2",
    "yargs": "18.0.0"
  },
  "overrides": {
    "js-yaml": "5.2.2",
    "markdown-it": "14.3.0",
    "linkify-it": "5.0.2"
  }
}
