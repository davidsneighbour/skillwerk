{
  "extends": "@dnbhq/tsconfig/cli",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "allowUnreachableCode": true,
    "exactOptionalPropertyTypes": false,
    "lib": ["ES2024", "DOM"],
    "noEmit": true,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["collections/**/*.ts", "scripts/**/*.ts"]
}
